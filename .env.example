# Render Backend Environment Variables Example
# Set these in your Render Web Service -> Environment Variables Dashboard

PORT=10000
ENVIRONMENT=production

# Supabase Credentials (Required for Tamil Nadu live auction properties & updates)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Admin Authentication & Token Secrets
ADMIN_JWT_SECRET=your-random-32-byte-hex-jwt-secret-here
ADMIN_EMAIL=admin@skandx.com
ADMIN_PASSWORD=your-secure-admin-password-here

# CORS Origins (Comma-separated list; accepts *.vercel.app for all Vercel previews & production)
ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000
