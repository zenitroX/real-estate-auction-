# Frontend Environment Configuration (for independent hosting on Vercel, Netlify, Cloudflare Pages)

# URL of your separately hosted Python API backend (e.g. on Render, Railway, Fly.io, or VPS)
# When deploying to Vercel/Netlify, set this in the platform environment variables dashboard.
# Both VITE_API_URL and VITE_API_BASE_URL are supported.
# Leave empty during local development with Vite dev proxy.
VITE_API_URL=http://localhost:8000
# VITE_API_BASE_URL=https://api.skandx.com
