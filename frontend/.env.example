# Vercel Frontend Environment Variables Example
# Set these in your Vercel Project Settings -> Environment Variables Dashboard

# The deployed Render backend service URL (without trailing slash)
VITE_API_URL=https://real-state-action.onrender.com

# Supabase Public Keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here
