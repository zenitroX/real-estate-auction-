# Gemini API Key (Required for Multimodal Vision & OCR parsing with gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Required for database storage & price-drop tracking)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Playwright & Scraper Configuration
PLAYWRIGHT_HEADLESS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
SCRAPE_STATE=Tamil Nadu
TMP_DOWNLOAD_DIR=./tmp_notices

# Engine Configuration
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-2.5-flash
REQUEST_TIMEOUT_SECONDS=30.0

